#!/usr/bin/env bash
# oobe-set-vconsole - restricted vconsole font configurator for OOBE
# Usage: oobe-set-vconsole <font-name>
set -euo pipefail

FONT="${1:-}"

if [[ $# -lt 1 || -z "$FONT" ]]; then
    echo "Usage: oobe-set-vconsole <font-name>" >&2
    exit 1
fi

# Validate font name: alphanumeric, hyphens, underscores only
if [[ ! "$FONT" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]]; then
    echo "oobe-set-vconsole: invalid font name '$FONT'" >&2
    exit 1
fi

if grep -q '^FONT=' /etc/vconsole.conf 2>/dev/null; then
    sed -i "s/^FONT=.*/FONT=$FONT/" /etc/vconsole.conf
else
    printf 'FONT=%s\n' "$FONT" >> /etc/vconsole.conf
fi
